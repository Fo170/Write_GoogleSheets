// ============================================================
// secrets.h.example — MODÈLE à copier (ce fichier-ci EST publié)
//
//   1. Copiez ce fichier en `secrets.h` (même dossier).
//   2. Renseignez vos valeurs réelles.
//   3. `secrets.h` est exclu par .gitignore → il ne sera jamais publié.
//
// Sans `secrets.h`, l'exemple compile avec des placeholders (non fonctionnel).
// ============================================================
#pragma once

// ---- Google Sheets ----
